# Copie para .env (o .env NUNCA vai para o Git).
PRTG_URL=https://prtg.exemplo.local
PRTG_APIKEY_LEITURA=coloque-aqui-a-chave-de-LEITURA-do-PRTG
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha
GRAFANA_ROOT_URL=http://noc.exemplo.local:3000
TOPO_USUARIO=noc
# sha256 da senha da topologia. Gere com:  python -c "import hashlib;print(hashlib.sha256(b'SUA-SENHA').hexdigest())"
TOPO_SENHA_SHA256=
# Senha longa e aleatória que o Grafana usa para falar com o intermediário. Gere com:  python -c "import secrets;print(secrets.token_urlsafe(32))"
TOPO_PROXY_TOKEN=
